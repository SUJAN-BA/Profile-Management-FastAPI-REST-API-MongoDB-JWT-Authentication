{
  "info": {
    "_postman_id": "bc6157b9-b66c-4ea6-9ec8-e889ffed3900",
    "name": "Authentication and Profile API",
    "description": "Register, authenticate, manage a profile, and revoke a bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "password",
      "value": "change-this-password"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testEmail')) {",
          "  pm.collectionVariables.set('testEmail', `api-test-${Date.now()}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Account created or already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().access_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authenticated user returned', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/profile/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Profile returned or not yet created', () => pm.expect([200, 404]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"API Test User\",\n  \"phone_number\": \"+1 555 123 4567\",\n  \"date_of_birth\": \"1995-05-12\",\n  \"gender\": \"prefer_not_to_say\",\n  \"is_jss_student\": false,\n  \"hobbies\": [\"Reading\"],\n  \"interests\": [\"Technology\"],\n  \"address\": \"123 Example Street\",\n  \"branch\": \"CSE\"\n}"
        },
        "url": "{{baseUrl}}/api/profile/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Profile saved', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token revoked', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset('token');"
            ]
          }
        }
      ]
    }
  ]
}
